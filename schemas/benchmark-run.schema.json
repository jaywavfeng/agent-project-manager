{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaywavfeng/agent-project-manager/schemas/benchmark-run.schema.json",
  "title": "Agent Project Manager Benchmark Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "strategy",
    "success",
    "test_pass_rate",
    "tokens",
    "measurement_source",
    "measurement_evidence",
    "estimated_cost",
    "credits_used",
    "duration_seconds",
    "model_switches",
    "worker_threads",
    "escalations",
    "user_interventions",
    "recorded_at",
    "notes"
  ],
  "properties": {
    "purpose_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordination", "task", "unclassified", "source", "evidence", "synthetic"],
      "properties": {
        "coordination": {"type": "integer", "minimum": 0},
        "task": {"type": "integer", "minimum": 0},
        "unclassified": {"type": "integer", "minimum": 0},
        "source": {"enum": ["host-purpose-telemetry", "documented-purpose-attribution"]},
        "evidence": {"type": "string", "minLength": 1},
        "synthetic": {"type": "boolean"}
      }
    },
    "schema_version": { "const": 2 },
    "task_id": { "type": "string", "minLength": 1 },
    "strategy": { "enum": ["strong-only", "tiered"] },
    "success": { "type": "boolean" },
    "test_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "strong", "balanced", "economy"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "strong": { "type": "integer", "minimum": 0 },
        "balanced": { "type": "integer", "minimum": 0 },
        "economy": { "type": "integer", "minimum": 0 }
      }
    },
    "measurement_source": {
      "enum": [
        "host-per-model-telemetry",
        "documented-manual-per-conversation"
      ]
    },
    "measurement_evidence": { "type": "string", "minLength": 1 },
    "estimated_cost": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "credits_used": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "model_switches": { "type": "integer", "minimum": 0 },
    "worker_threads": { "type": "integer", "minimum": 0 },
    "escalations": { "type": "integer", "minimum": 0 },
    "user_interventions": { "type": "integer", "minimum": 0 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
